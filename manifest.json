{
  "manifest_version": 3,
  "name": "Boosty Video Download",
  "version": "1.4",
  "description": "Скачивание видео с Boosty через кнопку в расширении.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://boosty.to/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Скачать видео Boosty",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
